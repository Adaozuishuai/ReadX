{
  "name": "@cbct/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "v2 前端：三栏精读工作区（React + Vite + Tailwind）",
  "scripts": {
    "predev": "node ../../scripts/prepare-pdf.mjs",
    "prebuild": "node ../../scripts/prepare-pdf.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@cbct/shared": "0.0.0",
    "katex": "^0.16.47",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vite": "^8.3.4"
  }
}
