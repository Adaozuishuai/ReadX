{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/core/**/*.ts", "src/main/discovery.ts", "src/main/fetchPaper.ts", "src/main/repository.ts", "src/main/retrieval.ts", "src/main/figureAnalysis.ts", "src/main/winOcr.ts", "src/tests/**/*.ts"]
}
